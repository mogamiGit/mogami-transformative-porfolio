{
  "name": "mogami-transformative-portfolio",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=devcontainer-node-modules,target=/workspace/node_modules,type=volume"
  ],
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Payload CMS / Next.js",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "unifiedjs.vscode-mdx"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit",
          "source.fixAll.eslint": "explicit"
        },
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "postCreateCommand": "pnpm install && pnpm exec playwright install --with-deps chromium",
  "postStartCommand": "echo '✅ Dev container ready. Run: pnpm dev'",
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "runArgs": [
    "--name", "mogami-portfolio",
    "--env-file", "${localWorkspaceFolder}/.env",
    "--shm-size=1gb",
    "--cpus=1.5",
    "--memory=4g"
  ],
  "shutdownAction": "stopContainer"
}
